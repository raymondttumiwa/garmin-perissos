-- 1. Create table with all required columns and primary key (if it doesn't exist yet)
CREATE TABLE IF NOT EXISTS public.garmin_daily_metrics (
    date DATE PRIMARY KEY,
    steps INTEGER DEFAULT 0,
    sleep_hours NUMERIC(4,1) DEFAULT 0.0,
    sleep_score INTEGER DEFAULT 0,
    active_min INTEGER DEFAULT 0,
    resting_hr INTEGER DEFAULT 60,
    body_battery INTEGER DEFAULT 80,
    stress_avg INTEGER DEFAULT 28,
    active_kcal INTEGER DEFAULT 0,
    workout_label TEXT DEFAULT 'Rest Day',
    manual_logs JSONB DEFAULT '{}'::jsonb,
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Ensure all columns exist (in case the table already existed from an older version)
ALTER TABLE public.garmin_daily_metrics 
    ADD COLUMN IF NOT EXISTS steps INTEGER DEFAULT 0,
    ADD COLUMN IF NOT EXISTS sleep_hours NUMERIC(4,1) DEFAULT 0.0,
    ADD COLUMN IF NOT EXISTS sleep_score INTEGER DEFAULT 0,
    ADD COLUMN IF NOT EXISTS active_min INTEGER DEFAULT 0,
    ADD COLUMN IF NOT EXISTS resting_hr INTEGER DEFAULT 60,
    ADD COLUMN IF NOT EXISTS body_battery INTEGER DEFAULT 80,
    ADD COLUMN IF NOT EXISTS stress_avg INTEGER DEFAULT 28,
    ADD COLUMN IF NOT EXISTS active_kcal INTEGER DEFAULT 0,
    ADD COLUMN IF NOT EXISTS workout_label TEXT DEFAULT 'Rest Day',
    ADD COLUMN IF NOT EXISTS manual_logs JSONB DEFAULT '{}'::jsonb,
    ADD COLUMN IF NOT EXISTS updated_at TIMESTAMPTZ DEFAULT NOW();

-- 3. Ensure 'date' is correctly set as the Primary Key for upserts
DO $$ 
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_constraint 
        WHERE conrelid = 'public.garmin_daily_metrics'::regclass 
        AND contype = 'p'
    ) THEN
        ALTER TABLE public.garmin_daily_metrics ADD PRIMARY KEY (date);
    END IF;
END $$;

-- 4. Enable Row Level Security (RLS)
ALTER TABLE public.garmin_daily_metrics ENABLE ROW LEVEL SECURITY;

-- 5. Set up clean API access policies
DROP POLICY IF EXISTS "Allow public read of garmin metrics" ON public.garmin_daily_metrics;
CREATE POLICY "Allow public read of garmin metrics"
    ON public.garmin_daily_metrics FOR SELECT
    USING (true);

DROP POLICY IF EXISTS "Allow anon upsert of garmin metrics" ON public.garmin_daily_metrics;
CREATE POLICY "Allow anon upsert of garmin metrics"
    ON public.garmin_daily_metrics FOR INSERT
    WITH CHECK (true);

DROP POLICY IF EXISTS "Allow anon update of garmin metrics" ON public.garmin_daily_metrics;
CREATE POLICY "Allow anon update of garmin metrics"
    ON public.garmin_daily_metrics FOR UPDATE
    USING (true);

